    titleColor: "#1e1b4b"
    fontFamily: "ui-sans-serif, system-ui, -apple-system, sans-serif"
    fontSize: "13px"
---
flowchart TB
    User([Learner]) -->|"pastes Japanese"| HTML["index.html\nText box, reading, side column"]
    Host([Runcible]) -->|"yomu:load via postMessage"| embed["embed.js\nyomu-embed/1"]

    subgraph Page["Page (ES modules)"]
        HTML --> app["app.js\nEntry point"]
        app --> events["events.js\nInput, selection, hover and tap"]
        events --> reader["reader.js\nSeam to the analyzer"]
        events --> render["render*.js\nReading, word panel, kanji table, notes"]
        events --> speech["speech.js\nJapanese voice, sound it out"]
        embed --> reader
    end

    subgraph Analyzer["Analyzer (no DOM, tested under node)"]
        reader --> analyze["analyze.js\nText in, tokens out"]
        analyze --> lattice["lattice.js + costs.js\nCheapest path"]
        lattice --> deinflect["deinflect.js\nConjugation rules"]
        lattice --> numbers["numbers.js + names.js\nCounters, name guesses"]
        analyze --> furigana["furigana.js\nReading per kanji"]
        analyze --> kana["kana.js\nBeats, said and spelled romaji"]
        analyze --> notes["sounds.js + grammar.js\nSpecial sounds, grammar ids"]
        lattice --> dict["dict.js\nLoads only the shards needed"]
    end

    dict -->|"fetch"| Data[("data/dict: 27 JMdict shards\ndata/kanji: 3 KANJIDIC shards")]
    state["state.js\nPreferences, text"] <-->|"yomu-site:preferences\nyomu-site:text"| Storage[("localStorage")]
    events --> state
    events --> mykanji["kanji-store.js + history-store.js\nMy kanji, collection, History"]
    mykanji <-->|"yomu-site:kanji\nyomu-site:history (only with Remember on)"| Storage
    mykanji -->|"collection.js fetches once"| Joyo[("data/kanji/joyo.json\njōyō by grade")]
    events --> play["events-play.js + play-rounds.js\nPlay: four look-alike games"]
    play <-->|"yomu-site:play\nbest scores, pairs mixed up"| Storage
    play -->|"fetch on #/play"| PlayData[("data/play/lookalikes.json\ndata/names/popular.json")]

    subgraph Accounts["Accounts (a Clerk key, no embed)"]
        account["account.js + events-sync.js\nSign-in, when to sync"]
        kit["neorgon-auth.js\nNeorgon Auth Kit"]
        sync["sync.js + sync-local.js + sync-rules.js\nPull, merge here, push what the account lacks"]
        account --> kit
        account -->|"import() on sign-in"| sync
    end
    app -.->|"import() with a key"| account
    kit -->|"only on Sign in or a Neorgon session"| Clerk(["clerk.neorgon.com"])
    sync -->|"through each store's own merge"| mykanji
    sync --> play
    account <-->|"yomu-site:sync (once synced)"| Storage
    sync <-->|"signed in: My kanji, saved phrases,\nPlay, display preferences"| Convex[("Convex project yomu\nrows per owner, tombstones kept")]
